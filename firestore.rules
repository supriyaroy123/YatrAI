rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // Allow read/write to the user document only if authenticated as that user
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Allow read/write to the user's history subcollection only if authenticated as that user
      match /history/{predictionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
